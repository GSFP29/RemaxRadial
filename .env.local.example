# Copiar para .env.local e preencher com os valores do projeto Supabase.
# Nunca comitar .env.local — já está no .gitignore.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só usada em rotas de servidor (ex: ingestão da API RE/MAX, parsing de email).
# Ignora RLS por completo — nunca expor ao browser.
SUPABASE_SERVICE_ROLE_KEY=

# Chave partilhada para autorizar a rota /api/ingest/imoveis.
# Gera uma string aleatória qualquer e usa-a também no cron que chama a rota.
INGEST_SECRET=
